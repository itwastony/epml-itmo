# ClearML Server Environment Variables
# Copy this file to .env and fill in the values

# Host IP for ClearML services (use localhost for local development)
CLEARML_HOST_IP=localhost

# API credentials (auto-generated on first run, or set manually)
CLEARML_ACCESS_KEY=
CLEARML_SECRET_KEY=

# Git credentials for ClearML Agent (optional)
GIT_USER=
GIT_PASS=
